<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/crmbridge/db" VERSION="2026090900" COMMENT="local_crmbridge — CRM webhook delivery log / dead-letter.">
  <TABLES>
    <TABLE NAME="local_crmbridge_delivery" COMMENT="One row per webhook delivery attempt batch. Successful rows are pruned by the cleanup task; failed rows are the dead-letter queue shown on the settings page.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventid" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="Monotonic id sent to the CRM for idempotency."/>
        <FIELD NAME="eventname" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="payload" TYPE="text" NOTNULL="true" COMMENT="JSON envelope body."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" COMMENT="pending|sent|failed|dead"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="lasterror" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="httpcode" TYPE="int" LENGTH="4" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="eventid" UNIQUE="true" FIELDS="eventid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status, timemodified"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
