# Copy this file to .env and fill in real values. Never commit .env.

DATABASE=
RESEND_API=
OPENAI_API_KEY=
JWT_SECRET=
NODE_ENV=development
OPENSSL_CONF=
PUBLIC_SERVER_FILE=

# Login OTP emails (Gmail SMTP via Nodemailer)
# GMAIL_USER: the Gmail address emails are sent from.
# GMAIL_APP_PASSWORD: a 16-character App Password, NOT your normal Gmail password —
#   generate one at https://myaccount.google.com/apppasswords (needs 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=Career Lab Consulting

# Meta / Facebook Marketing API integration
# See the setup walkthrough in the chat response this was delivered with.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8888/public/facebook/callback
META_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes, base64-encoded — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
META_TOKEN_ENCRYPTION_KEY=
APP_URL=http://localhost:3000

# Google Ads API integration
# See the setup walkthrough in the chat response this was delivered with.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# 22-char alphanumeric token from the Google Ads API Center — requires
# Google's manual basic/standard access approval, this can't be automated.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_REDIRECT_URI=http://localhost:8888/public/google/callback
# 32 random bytes, base64-encoded — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# LinkedIn Marketing API integration
# See the setup walkthrough in the chat response this was delivered with.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn-Version header required on every /rest/* call, format YYYYMM
LINKEDIN_API_VERSION=202601
LINKEDIN_REDIRECT_URI=http://localhost:8888/public/linkedin/callback
# 32 random bytes, base64-encoded — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINKEDIN_TOKEN_ENCRYPTION_KEY=
# How often the lead poller runs, in ms (default 5 minutes if unset)
LINKEDIN_POLL_INTERVAL_MS=300000

# GitHub integration (Git Management module) — create an OAuth App at
# https://github.com/settings/developers (Authorization callback URL must
# exactly match GITHUB_REDIRECT_URI below). Each employee connects their own
# GitHub account from inside the CRM; no org-wide token is stored.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8888/public/git/callback
# 32 random bytes, base64-encoded — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEY=

# Vercel integration (Vercel Management module) — create an Integration at
# https://vercel.com/dashboard/integrations/console ("Create" -> External
# Integration Settings). Redirect URL there must exactly match
# VERCEL_REDIRECT_URI below. VERCEL_INTEGRATION_SLUG is the "URL Slug" you
# picked when creating it. Each employee connects their own Vercel account;
# no org-wide token is stored.
VERCEL_INTEGRATION_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_REDIRECT_URI=http://localhost:8888/public/vercel/callback
# 32 random bytes, base64-encoded — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VERCEL_TOKEN_ENCRYPTION_KEY=

# ── Calling / call-center module ──────────────────────────────────────────
#   mock       runs the whole workflow with NO telephony server (default)
#   cloud      cloud calling API (Edesy / Tata Smartflo / Exotel / Ozonetel /
#              Knowlarity / Servetel / Twilio) — real calls, NO VPS. Recommended.
#   telephony  talks to the VPS Telephony Integration Service (VICIdial + Asterisk)
CALLING_PROVIDER=mock

# ── CLOUD calling API (only used when CALLING_PROVIDER=cloud) ─────────────
# One provider account. Their servers ring the agent's phone first, then the
# customer, and bridge the two; call status + recording URL come back on the
# webhook below. India: finish the provider's KYC + outbound caller-ID / DLT
# verification before real calls connect.
#
# Default target: Edesy number masking.
#   CLOUD_CALL_PROVIDER=edesy
#   CLOUD_CALL_API_BASE=https://voice-api.edesy.in/v1
#   CLOUD_CALL_API_KEY  = Edesy portal → API key (starts vp_) — used as the Bearer
#   CLOUD_CALL_CALLER_ID = a number from your Edesy pool (Edesy still picks the
#                          masked number itself; this is just for display/checks)
#   In the Edesy portal (https://masking.edesy.in) set the webhook URL to:
#     <backend>/api/cloud-call/webhook
#   and paste its "webhook signing secret" as CLOUD_CALL_WEBHOOK_SECRET (verified
#   as an HMAC-SHA256 of the raw body). ?secret=<value> also works if the portal
#   allows a query string instead.
# Alt target: Tata Smartflo → CLOUD_CALL_PROVIDER=tata,
#   CLOUD_CALL_API_BASE=https://api-smartflo.tatateleservices.com,
#   CLOUD_CALL_API_TOKEN = Smartflo panel API Token (Bearer).
CLOUD_CALL_PROVIDER=            # edesy | tata | exotel | ozonetel | knowlarity | servetel | twilio
CLOUD_CALL_API_BASE=           # edesy: https://voice-api.edesy.in/v1
CLOUD_CALL_ACCOUNT_SID=        # account SID / subdomain (exotel/twilio) — blank for Edesy/Tata
CLOUD_CALL_API_KEY=            # edesy: the vp_ API key (Bearer); exotel/twilio: API key
CLOUD_CALL_API_TOKEN=          # Bearer API token / secret — blank for Edesy
CLOUD_CALL_CALLER_ID=          # your DID / masked number shown to the customer
CLOUD_CALL_REGION=             # optional — some providers need a region/zone
CLOUD_CALL_TIMEOUT_MS=8000
# Secret to verify the provider's call-status webhook. Edesy: the portal's
# webhook signing secret (checked as HMAC-SHA256 of the raw body, header
# x-edesy-signature / x-webhook-signature). Smartflo-style: the same literal
# value in ?secret=… or an x-webhook-secret header. Path: <backend>/api/cloud-call/webhook
CLOUD_CALL_WEBHOOK_SECRET=     # 32+ random bytes

# ── Edesy VOICE-AGENT product (IVR menus, DTMF capture, in-call transfer) ──
# A DIFFERENT Edesy product from number-masking above — its own base URL, a
# `vp_live_` / `vp_test_` API key, and a workspace id. Leave blank to keep
# masking-only behaviour (outbound bridge works; IVR + transfer are disabled).
# Inbound IVR menus are built in the Edesy dashboard; the CRM stores a copy as
# an "IVR Flow" so /api/cloud-call/webhook can label pressed digits and route.
CLOUD_CALL_VOICE_BASE=https://voice-agent.edesy.in/api/v1
CLOUD_CALL_VOICE_KEY=          # vp_live_… voice-agent API key (Bearer)
CLOUD_CALL_WORKSPACE_ID=       # Edesy workspace id
CLOUD_CALL_AGENT_ID=           # default voice-agent / flow id for outbound

# ── CRM → VPS (only used when CALLING_PROVIDER=telephony). The CRM signs every
# request; the VPS verifies. NO SIP / AMI / DB detail ever reaches the CRM.
TELEPHONY_API_URL=            # https://telephony.yourdomain.com
TELEPHONY_API_KEY=            # shared key (also set on the VPS as CRM_API_KEY)
TELEPHONY_HMAC_SECRET=        # 32+ random bytes; VPS side = CRM_HMAC_SECRET
TELEPHONY_TIMEOUT_MS=8000

# VPS → CRM webhook (/api/telephony/*). The VPS signs; the CRM verifies.
TELEPHONY_WEBHOOK_KEY=        # VPS side = WEBHOOK_API_KEY
TELEPHONY_WEBHOOK_HMAC_SECRET=  # VPS side = WEBHOOK_HMAC_SECRET
TELEPHONY_WEBHOOK_TOLERANCE_SEC=300

# generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Legacy direct-VICIdial stub (CALLING_PROVIDER=vicidial) — not used by the
# telephony integration; kept for reference only.
VICIDIAL_URL=
VICIDIAL_API_USER=
VICIDIAL_API_PASS=
VICIDIAL_SOURCE=crm

# ============================================================================
# LMS / Moodle + BigBlueButton integration  (services/lms/, config/lms.js)
# ----------------------------------------------------------------------------
# Leave MOODLE_WS_URL blank to run "unconfigured": the LMS portals render a
# degraded state, the webhook returns 503, sync jobs park instead of erroring.
# ============================================================================

# CRM -> Moodle Web Services (REST). Create a dedicated external service +
# system-account token in Moodle (Site admin > Server > Web services), enable
# the REST protocol, and IP-allow-list the CRM server.
MOODLE_WS_URL=                 # https://learn.yourdomain.com  (site root, NOT /webservice)
MOODLE_WS_TOKEN=               # external-service token for the system account
MOODLE_WS_TIMEOUT_MS=12000
MOODLE_WS_CACHE_TTL_SEC=30
MOODLE_WS_BREAKER_THRESHOLD=5
MOODLE_WS_BREAKER_COOLOFF_MS=30000
MOODLE_WS_RETRY_ATTEMPTS=3
MOODLE_WS_RETRY_BASE_MS=400

# Course-shell creation from the CRM (syncService.mirrorCourse):
MOODLE_DEFAULT_CATEGORY_ID=1       # Moodle category new course shells land in (1 = "Miscellaneous")
MOODLE_PROVISION_AUTH=manual       # auth plugin for CRM-provisioned accounts: manual | nologin
MOODLE_COURSE_SHORT_PREFIX=clc     # prefix for generated unique course shortnames

# Numeric Moodle role ids, as JSON. deploy/moodle/setup.sh prints these after
# it creates the custom `counsellor` / `contentmanager` roles. Falls back to a
# stock install's ids when unset.
MOODLE_ROLE_IDS={"manager":1,"coursecreator":2,"editingteacher":3,"teacher":4,"student":5}

# Moodle (local_crmbridge) -> CRM webhook  (POST /api/lms/webhook/moodle).
# Moodle signs every event; the CRM verifies. Set the same secret in the
# local_crmbridge plugin settings.
MOODLE_WEBHOOK_KEY=            # optional coarse key (x-crm-key)
MOODLE_WEBHOOK_HMAC_SECRET=    # 32+ random bytes; also set in local_crmbridge
MOODLE_WEBHOOK_TOLERANCE_SEC=300
MOODLE_WEBHOOK_ALLOW_IPS=      # optional, comma-separated IPs or CIDRs (Moodle host)

# CRM -> Moodle single sign-on (local_crmsso). The CRM mints a 60s single-use
# JWT; local_crmsso verifies it and starts the Moodle session.
MOODLE_SSO_SECRET=            # shared HS256 key; also set in local_crmsso
MOODLE_SSO_TOKEN_TTL_SEC=60
MOODLE_SSO_ISSUER=clc-crm
MOODLE_SSO_AUDIENCE=moodle

# BigBlueButton (dedicated host). Also the live-class meeting provider: once
# BBB_URL + BBB_SECRET are set the CRM creates + joins real BBB rooms and the
# provider auto-switches from mock/jitsi — no data migration.
BBB_URL=                      # https://bbb.yourdomain.com/bigbluebutton
BBB_SECRET=
BBB_TIMEOUT_MS=10000
BBB_CHECKSUM_ALGO=sha1        # sha1 | sha256 (match the BBB server)
BBB_RECORD=true               # record live classes by default

# ── Live-class meeting provider (services/lms/meeting/) ──────────────────
# auto  -> bigbluebutton when BBB is configured, else Jitsi (REAL video).
#          Jitsi base defaults to the public https://meet.jit.si — point
#          LMS_MEETING_JITSI_BASE at your own Jitsi for privacy/recording.
#          Force the offline placeholder room with LMS_MEETING_PROVIDER=mock.
LMS_MEETING_PROVIDER=auto     # auto | bigbluebutton | jitsi | mock
LMS_MEETING_JITSI_BASE=       # blank = https://meet.jit.si ; or https://jitsi.yourdomain.com
LMS_MEETING_DEFAULT_DURATION_MIN=60
LMS_MEETING_JOIN_TICKET_TTL_SEC=120
# Public base URL of the CRM — used for BBB logoutURL + the join redirect.
LMS_CRM_BASE_URL=             # defaults to APP_URL / PUBLIC_SERVER_FILE, e.g. http://200.141.5.195

# ── Live-class lifecycle / recording / webhook ─────────────────────────
LMS_BBB_WEBHOOK_TOKEN=        # shared token the bbb-webhooks module sends on ?token=
LMS_LIVE_TICK_MS=30000        # lifecycle + recording-poll + notification worker interval
LMS_MAX_AUTO_CLASSES=400      # hard cap on auto-generated sessions per batch
LMS_MIN_BATCH_MONTHS=6        # batch schedule + meeting room span at least this many months (same link)
LMS_EMAIL_BATCH_STUDENTS=true # email batch students the class link + schedule on create / add
# Attendance thresholds / recording policy / permissions are runtime-editable
# in the CRM (Admin -> LMS -> Attendance settings) — model LmsSetting('live').

# Outbound sync worker (jobs/lmsSyncTick.js).
LMS_SYNC_TICK_MS=15000
LMS_SYNC_MAX_ATTEMPTS=6
LMS_SYNC_BATCH_SIZE=25
LMS_SYNC_RECONCILE_HOUR=3     # 0-23 server local time; -1 to disable

# generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
